---
import { type ArticleSummary } from '../lib/articles';

interface Props {
  post: ArticleSummary;
}

const { post } = Astro.props;
---

<article class="blog-post-card">
  <a class="blog-post-card__link" href={post.path}>
    <div class="blog-post-card__media">
      {post.image ? (
        <img
          src={post.image}
          alt={post.imageAlt || post.title}
          width="640"
          height="336"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="blog-post-card__media--placeholder" aria-hidden="true">📷</div>
      )}
    </div>
    <div class="blog-post-card__body">
      <h2 class="blog-post-card__title">{post.title}</h2>
      {post.excerpt && <p class="blog-post-card__excerpt">{post.excerpt}</p>}
      <span class="blog-post-card__more">Read More →</span>
    </div>
  </a>
</article>
