---
/** Homepage-only: Splide carousels + Kadence count-up animations */
---

<link rel="stylesheet" href="/styles/splide-core.min.css" />

<script>
  import Splide from '@splidejs/splide';

  function formatCount(value, separator) {
    const parts = Math.round(value).toString().split('');
    if (!separator) return parts.join('');
    let out = '';
    for (let i = 0; i < parts.length; i++) {
      const fromEnd = parts.length - i;
      if (i > 0 && fromEnd % 3 === 0) out += separator;
      out += parts[i];
    }
    return out;
  }

  function animateCounter(el) {
    const end = Number(el.dataset.end ?? '0');
    const start = Number(el.dataset.start ?? '0');
    const duration = Number(el.dataset.duration ?? '2.5') * 1000;
    const prefix = el.dataset.prefix ?? '';
    const suffix = el.dataset.suffix ?? '';
    const separator = el.dataset.separator ?? '';
    const target =
      el.querySelector('.kb-count-up-number') ?? el.querySelector('.kb-count-up-process');
    if (!target || Number.isNaN(end)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      target.textContent = `${prefix}${formatCount(end, separator)}${suffix}`;
      return;
    }

    const t0 = performance.now();
    const tick = (now) => {
      const p = Math.min((now - t0) / duration, 1);
      const eased = 1 - (1 - p) ** 3;
      const current = start + (end - start) * eased;
      target.textContent = `${prefix}${formatCount(current, separator)}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function initCounters() {
    const counters = document.querySelectorAll('.kb-count-up[data-end]');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          animateCounter(entry.target);
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    counters.forEach((el) => observer.observe(el));
  }

  function initCarousels() {
    const roots = document.querySelectorAll('.kt-blocks-carousel-init, .splide');
    const seen = new Set();

    roots.forEach((root) => {
      if (seen.has(root) || root.classList.contains('is-initialized')) return;
      if (!root.querySelector('.splide__track')) return;
      seen.add(root);
      if (!root.classList.contains('splide')) root.classList.add('splide');

      const speed = Number(root.getAttribute('data-slider-speed') ?? '5000');
      const gap = root.getAttribute('data-slider-gap') ?? '10px';
      const isGallery = root.classList.contains('kb-gallery-carousel');
      const perPage = isGallery ? 4 : 3;

      new Splide(root, {
        type: 'loop',
        perPage,
        perMove: 1,
        gap,
        speed: 600,
        autoplay: true,
        interval: speed || 5000,
        pauseOnHover: true,
        pauseOnFocus: true,
        arrows: !root.classList.contains('kt-carousel-arrowstyle-none'),
        pagination: true,
        drag: true,
        breakpoints: {
          1024: { perPage: isGallery ? 3 : 2 },
          767: { perPage: 1 },
        },
      }).mount();

      root.classList.add('splide-initialized');
    });
  }

  function boot() {
    initCarousels();
    initCounters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
