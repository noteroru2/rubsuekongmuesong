---
import { COMPANY, CONTACT, FOOTER_LOGO_URL, LINE_ID, NAV_LINKS, SITE_NAME } from '../config/site';

const cameraBrands = [
  { label: 'รับซื้อกล้อง Canon', href: '/models/#canon' },
  { label: 'รับซื้อกล้อง Sony', href: '/models/#sony' },
  { label: 'รับซื้อกล้อง Fujifilm', href: '/models/#fujifilm' },
  { label: 'รับซื้อกล้อง Nikon', href: '/models/#nikon' },
  { label: 'รับซื้อกล้อง Leica', href: '/models/#leica' },
  { label: 'รับซื้อกล้อง Panasonic', href: '/models/#panasonic' },
  { label: 'รับซื้อกล้อง Olympus', href: '/models/#olympus' },
  { label: 'รับซื้อกล้อง DJI', href: '/models/#dji' },
];
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <!-- Brand column -->
    <div class="site-footer__brand">
      <img
        src={FOOTER_LOGO_URL}
        alt={SITE_NAME}
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
      />
      <p class="site-footer__tagline">รับซื้อกล้องมือสองทุกยี่ห้อ<br />ประเมินฟรี โอนทันที</p>
      <div style="margin-top:1rem; display:flex; gap:0.6rem;">
        <a href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer" aria-label={`LINE ${LINE_ID}`} style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--card);border:1px solid var(--border);border-radius:8px;transition:border-color .15s">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"></path>
          </svg>
        </a>
        <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--card);border:1px solid var(--border);border-radius:8px;transition:border-color .15s">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
          </svg>
        </a>
        <a href={CONTACT.googleReviews} target="_blank" rel="noopener noreferrer" aria-label="Google Reviews" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--card);border:1px solid var(--border);border-radius:8px;transition:border-color .15s">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21.35 11.1H12.18V13.83H18.69C18.36 17.64 15.19 19.27 12.19 19.27C8.36 19.27 5 16.25 5 12C5 7.9 8.2 4.73 12.2 4.73C15.29 4.73 17.1 6.7 17.1 6.7L19 4.72C19 4.72 16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12C2.03 17.05 6.16 22 12.25 22C17.6 22 21.5 18.33 21.5 12.91C21.5 11.76 21.35 11.1 21.35 11.1Z"/></svg>
        </a>
      </div>
    </div>

    <!-- Menu column -->
    <div>
      <h2>เมนู</h2>
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact column -->
    <div>
      <h2>ติดต่อเรา</h2>
      <div class="site-footer__contact-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <a href={CONTACT.phoneHref}>064-257-9353</a>
      </div>
      <div class="site-footer__contact-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"></path>
        </svg>
        <a href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">LINE: {LINE_ID}</a>
      </div>
      <div class="site-footer__contact-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{COMPANY.address}</span>
      </div>
    </div>

    <!-- Cameras column -->
    <div>
      <h2>กล้องที่รับซื้อ</h2>
      <ul>
        {cameraBrands.map((b) => (
          <li><a href={b.href}>{b.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} {SITE_NAME} — {COMPANY.name}</p>
    <p>รับซื้อกล้องมือสอง Leica · Olympus · Canon · Sony · Nikon · Fujifilm · DJI</p>
  </div>
</footer>
