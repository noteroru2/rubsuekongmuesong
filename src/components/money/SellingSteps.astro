---
import type { MoneyStep } from '../../lib/moneyPages/types';

interface Props {
  steps: MoneyStep[];
  heading?: string;
}

const { steps, heading = 'วิธีขายกล้อง 3 ขั้นตอน' } = Astro.props;
---

<section class="money-section selling-steps" aria-labelledby="selling-steps-heading">
  <h2 id="selling-steps-heading" class="money-section__title">{heading}</h2>
  <ol class="selling-steps__list">
    {
      steps.map((step, i) => (
        <li class="selling-steps__item">
          <span class="selling-steps__num" aria-hidden="true">{i + 1}</span>
          <div class="selling-steps__copy">
            <strong>{step.title}</strong>
            <p>{step.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
