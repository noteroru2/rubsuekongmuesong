---
import {
  absoluteAsset,
  APPLE_TOUCH_ICON_URL,
  FAVICON_URL,
  SITE_NAME,
  SITE_URL,
} from '../config/site';
import type { PageRecord } from '../lib/types';
import { buildPageGraph } from '../lib/schema';
import { getOpenGraphType } from '../lib/pageIntent.js';
import { INDEX, getRouteIndexPolicy } from '../lib/indexPolicy.js';

interface Props {
  page: PageRecord;
}

const { page } = Astro.props;
const { seo } = page;
const indexPolicy = getRouteIndexPolicy(page);
const canonical =
  page.seo.canonical?.startsWith('http')
    ? page.seo.canonical
    : `${SITE_URL}${page.path}`;
const ogImage = seo.ogImage ? absoluteAsset(seo.ogImage) : undefined;
const schemaGraph = buildPageGraph(page);
const ogType = getOpenGraphType(page);
const robotsContent =
  indexPolicy.lifecycle !== INDEX
    ? 'noindex, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
    : seo.robots || 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{seo.title}</title>
{seo.metaDescription && <meta name="description" content={seo.metaDescription} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={robotsContent} />

{/* Open Graph — derived from current page intent, not migrated WordPress type. */}
<meta property="og:locale" content="th_TH" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={seo.ogTitle || seo.title} />
{seo.ogDescription && <meta property="og:description" content={seo.ogDescription} />}
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.ogTitle || seo.title} />
{seo.ogDescription && <meta name="twitter:description" content={seo.ogDescription} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}

{/* Icons */}
<link rel="icon" href={FAVICON_URL} sizes="32x32" type="image/webp" />
<link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_URL} />

{/* C3: one intent-aware JSON-LD graph. Visual FAQ content remains on-page,
    but FAQPage fallback/extraction markup is intentionally not emitted. */}
<script
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })}
/>
