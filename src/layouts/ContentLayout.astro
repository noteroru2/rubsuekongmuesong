---
import BaseLayout from './BaseLayout.astro';
import { fixWordPressHtml } from '../lib/fixHtml';
import type { PageRecord } from '../lib/types';

interface Props {
  page: PageRecord;
}

const { page } = Astro.props;
const isHomepage = page.pageType === 'homepage';
const isLocationPage =
  page.pageType === 'location' && page.path.startsWith('/รับซื้อกล้อง/');
const bodyHtml = fixWordPressHtml(page.bodyHtml || '');
const bodyHasH1 = /<h1[\s>]/i.test(bodyHtml);
const bodyClass = isHomepage ? 'page-home' : isLocationPage ? 'page-location' : '';
---

<BaseLayout page={page} bodyClass={bodyClass}>
  {
    isLocationPage && page.seo.h1 && (
      <div class="location-hero">
        <p class="location-hero__label">รับซื้อกล้อง</p>
        <h1 class="location-hero__title">{page.seo.h1}</h1>
      </div>
    )
  }
  <article class:list={['entry', isHomepage ? 'entry--home' : isLocationPage ? 'entry--location' : 'content-wrap']}>
    {!bodyHasH1 && page.seo.h1 && !isHomepage && !isLocationPage && (
      <h1 class="entry-title">{page.seo.h1}</h1>
    )}
    <div class="entry-content wp-content" set:html={bodyHtml} />
  </article>
  <slot name="after" />
</BaseLayout>
