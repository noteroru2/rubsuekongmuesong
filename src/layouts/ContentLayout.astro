---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCta from '../components/ContactCta.astro';
import HomeInteractions from '../components/HomeInteractions.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SellStepsStrip from '../components/SellStepsStrip.astro';
import TrustBar from '../components/TrustBar.astro';
import ArticleMoneyEnhancement from '../components/money/ArticleMoneyEnhancement.astro';
import CategoryHubEnhancement from '../components/money/CategoryHubEnhancement.astro';
import ProvinceMoneyPage from '../components/money/ProvinceMoneyPage.astro';
import ShutterCountEnhancement from '../components/money/ShutterCountEnhancement.astro';
import BaseLayout from './BaseLayout.astro';
import { buildBreadcrumbItems } from '../lib/breadcrumbs';
import { fixWordPressHtml } from '../lib/fixHtml';
import { sanitizeImportedHeadings } from '../lib/contentHygiene.js';
import {
  PAGE_INTENTS,
  classifyPageIntent,
  isEditorialIntent,
  isServiceIntent,
} from '../lib/pageIntent.js';
import {
  getProvinceMoneyPage,
  getShutterCountEnhancement,
  getArticleMoneyEnhancement,
  getCategoryHubEnhancement,
} from '../lib/moneyPages';
import type { PageRecord } from '../lib/types';

interface Props {
  page: PageRecord;
}

const { page } = Astro.props;
const intent = classifyPageIntent(page);
const isHomepage = page.pageType === 'homepage';
const isCategoryPage = page.pageType === 'category';
const isEditorialPage = isEditorialIntent(intent);
const isServicePage = isServiceIntent(intent);
const isLocalService = intent === PAGE_INTENTS.LOCAL_SERVICE;
const isGuidePage = intent === PAGE_INTENTS.GUIDE;
const isDetailPage = !isHomepage && !isCategoryPage;

const provinceMoney = getProvinceMoneyPage(page.path);
const shutterEnhancement = getShutterCountEnhancement(page.path);
const articleEnhancement = getArticleMoneyEnhancement(page.path);
const categoryHub = getCategoryHubEnhancement(page.path);
const isMoneyProvince = Boolean(provinceMoney);
const isMoneyShutter = Boolean(shutterEnhancement);
const isMoneyArticleEnh = Boolean(articleEnhancement);
const isCategoryHub = Boolean(categoryHub);
const hasMoneyEnhancement = isMoneyProvince || isMoneyShutter || isMoneyArticleEnh || isCategoryHub;

// C3: the Astro template owns H1. Imported WordPress H1s remain visible as H2s.
const rawBodyHtml = fixWordPressHtml(page.bodyHtml || '');
const bodyHtml = sanitizeImportedHeadings(rawBodyHtml);

const showDetailHero =
  isDetailPage &&
  page.seo.h1 &&
  !isMoneyProvince &&
  !isMoneyShutter &&
  !isCategoryHub;
const breadcrumbs = isDetailPage || isCategoryHub ? buildBreadcrumbItems(page) : [];
const bodyClass = isHomepage
  ? 'page-home'
  : isCategoryHub
    ? 'page-category-hub'
    : isLocalService
      ? 'page-location'
      : isEditorialPage
        ? 'page-article'
        : isServicePage
          ? 'page-service'
          : 'page-content';
const heroDescription =
  isDetailPage && page.seo.metaDescription && !isMoneyProvince
    ? page.seo.metaDescription.replace(/\s*\.\.\.\s*$/, '').trim()
    : '';
const heroLabel = isLocalService
  ? 'รับซื้อกล้องมือสอง'
  : isGuidePage
    ? 'คู่มือและความรู้เรื่องกล้อง'
    : isEditorialPage
      ? 'บทความกล้อง'
      : isServicePage
        ? 'บริการรับซื้อกล้องมือสอง'
        : '';
---

<BaseLayout page={page} bodyClass={bodyClass}>
  {
    isCategoryHub && categoryHub && (
      <div class="article-landing">
        <div class="article-landing__top">
          <Breadcrumbs items={breadcrumbs} />
          <CategoryHubEnhancement data={categoryHub} />
        </div>
      </div>
    )
  }
  {
    isDetailPage && !isMoneyShutter && (
      <div class="article-landing">
        <div class="article-landing__top">
          <Breadcrumbs items={breadcrumbs} />
          {
            isMoneyProvince && provinceMoney && (
              <ProvinceMoneyPage data={provinceMoney} h1={page.seo.h1 || ''} />
            )
          }
          {
            showDetailHero && (
              <div class="location-hero">
                {heroLabel && <p class="location-hero__label">{heroLabel}</p>}
                <h1 class="location-hero__title">{page.seo.h1}</h1>
                {heroDescription && <p class="location-hero__desc">{heroDescription}</p>}
              </div>
            )
          }
          {
            !isMoneyProvince && !isMoneyArticleEnh && (
              <>
                <TrustBar />
                <ContactCta />
              </>
            )
          }
        </div>
      </div>
    )
  }
  {
    isMoneyShutter && shutterEnhancement && (
      <div class="article-landing">
        <div class="article-landing__top">
          <Breadcrumbs items={breadcrumbs} />
          <div class="location-hero">
            <p class="location-hero__label">คู่มือและความรู้เรื่องกล้อง</p>
            <h1 class="location-hero__title">{page.seo.h1}</h1>
          </div>
        </div>
      </div>
    )
  }
  <article
    class:list={[
      'entry',
      isHomepage ? 'entry--home' : isDetailPage || isCategoryHub ? 'entry--article' : 'content-wrap',
      hasMoneyEnhancement && 'entry--money',
    ]}
  >
    {
      isMoneyShutter && shutterEnhancement && (
        <ShutterCountEnhancement data={shutterEnhancement} />
      )
    }
    {
      isMoneyArticleEnh && articleEnhancement && (
        <ArticleMoneyEnhancement data={articleEnhancement} />
      )
    }
    {
      !isCategoryHub && (
        <div
          class:list={[
            'entry-content',
            'wp-content',
            isDetailPage && 'content-article',
            hasMoneyEnhancement && 'entry-content--legacy',
          ]}
          set:html={bodyHtml}
        />
      )
    }
    {
      isCategoryHub && bodyHtml && (
        <div class="entry-content wp-content entry-content--legacy category-hub-archive" set:html={bodyHtml} />
      )
    }
  </article>
  {
    isDetailPage && !isMoneyProvince && !isMoneyArticleEnh && !isMoneyShutter && (
      <div class="article-landing__bottom">
        <SellStepsStrip />
        <ContactCta compact />
        {isEditorialPage && <RelatedPosts path={page.path} />}
      </div>
    )
  }
  {
    (isMoneyArticleEnh || isMoneyShutter) && (
      <div class="article-landing__bottom">
        <RelatedPosts path={page.path} />
      </div>
    )
  }
  {isHomepage && <HomeInteractions />}
  <slot name="after" />
</BaseLayout>
