---
import ContentLayout from '../layouts/ContentLayout.astro';
import { getAllRoutes, getPageByPath } from '../lib/content';
import { pathToSlugParam } from '../lib/seo';

export async function getStaticPaths() {
  const skipPaths = new Set(['/blog/', '/category/article/', '/models/', '/process/', '/review/', '/about/']);
  const routes = getAllRoutes().filter(
    (route) => route.path !== '/' && !skipPaths.has(route.path),
  );
  return routes.map((route) => ({
    params: { path: pathToSlugParam(route.path) },
    props: { pagePath: route.path },
  }));
}

interface Props {
  pagePath: string;
}

const { pagePath } = Astro.props;
const page = getPageByPath(pagePath);

if (!page) {
  throw new Error(`Missing content for path: ${pagePath}`);
}
---

<ContentLayout page={page} />
