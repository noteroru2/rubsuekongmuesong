---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getBlogPosts, paginateBlogPosts } from '../../../lib/articles';
import { getPageByPath } from '../../../lib/content';
import { SITE_NAME, SITE_URL } from '../../../config/site';
import type { PageRecord } from '../../../lib/types';

export function getStaticPaths() {
  const allPosts = getBlogPosts();
  const { totalPages } = paginateBlogPosts(allPosts, 1);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { pageNum: i + 2 },
  }));
}

interface Props {
  pageNum: number;
}

const { pageNum } = Astro.props;
const allPosts = getBlogPosts();
const { posts, currentPage, totalPages } = paginateBlogPosts(allPosts, pageNum);
const crawled = getPageByPath('/blog/');
const blogTitle = 'บทความรับซื้อกล้องมือสอง';
const pageTitle =
  pageNum > 1 ? `${blogTitle} — หน้า ${pageNum} - ${SITE_NAME}` : `${blogTitle} - ${SITE_NAME}`;

const page: PageRecord = crawled
  ? {
      ...crawled,
      seo: {
        ...crawled.seo,
        h1: blogTitle,
        title: pageTitle,
        canonical:
          pageNum > 1 ? `${SITE_URL}/blog/page/${pageNum}/` : `${SITE_URL}/blog/`,
      },
    }
  : {
      id: `blog-page-${pageNum}`,
      oldUrl: pageNum > 1 ? `${SITE_URL}/blog/page/${pageNum}/` : `${SITE_URL}/blog/`,
      path: pageNum > 1 ? `/blog/page/${pageNum}/` : '/blog/',
      pageType: 'archive',
      seo: {
        title: pageTitle,
        metaDescription: 'บทความรับซื้อกล้องมือสอง ขายกล้องมือสอง ทุกจังหวัด',
        canonical: pageNum > 1 ? `${SITE_URL}/blog/page/${pageNum}/` : `${SITE_URL}/blog/`,
        h1: blogTitle,
      },
      bodyHtml: '',
    };
---

<BaseLayout page={page} bodyClass="page-blog">
  <article class="entry blog-archive">
    <header class="blog-archive__hero">
      <h1 class="blog-archive__title">{blogTitle}</h1>
      <p class="blog-archive__intro">
        หน้า {currentPage} จาก {totalPages} — รวมบทความรับซื้อกล้องและขายกล้องมือสองทั่วประเทศ
      </p>
    </header>
    <BlogListing posts={posts} currentPage={currentPage} totalPages={totalPages} />
  </article>
</BaseLayout>
