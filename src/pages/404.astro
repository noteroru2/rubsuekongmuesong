---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../config/site';
import type { PageRecord } from '../lib/types';

const page: PageRecord = {
  id: '404',
  oldUrl: 'https://xn--12cman8e0bjt1czaccb9b1fg31ad.com/404/',
  path: '/404/',
  pageType: 'page',
  seo: {
    title: 'ไม่พบหน้าที่คุณต้องการ - รับซื้อกล้องมือสอง',
    metaDescription: 'ไม่พบหน้าที่คุณต้องการ กลับไปหน้าแรกหรือติดต่อเราเพื่อรับซื้อกล้องมือสอง',
    canonical: 'https://xn--12cman8e0bjt1czaccb9b1fg31ad.com/404/',
    h1: 'ไม่พบหน้าที่คุณต้องการ',
    robots: 'noindex, follow',
  },
  bodyHtml: '',
};
---

<BaseLayout page={page}>
  <section class="error-page">
    <h1>404 — ไม่พบหน้าที่คุณต้องการ</h1>
    <p>หน้าที่คุณค้นหาอาจถูกย้ายหรือไม่มีอยู่แล้ว</p>
    <div class="error-page__actions">
      <a class="btn" href="/">กลับหน้าแรก</a>
      <a class="btn btn--outline" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">ติดต่อขายกล้อง</a>
    </div>
  </section>
</BaseLayout>
