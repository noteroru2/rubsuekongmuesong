---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { getPageByPath } from '../../lib/content';
import { ABOUT_TRUST_GALLERY } from '../../lib/siteImages';
import { COMPANY, CONTACT, LINE_ID } from '../../config/site';

const page = getPageByPath('/about/');
if (!page) throw new Error('Missing /about/ content');
---

<BaseLayout page={page} bodyClass="page-about">
  <div class="inner-page">
    <!-- Hero -->
    <div class="about-hero">
      <p style="font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--primary);margin-bottom:.5rem;">เกี่ยวกับเรา</p>
      <h1>รับซื้อกล้องมือสอง อุบลราชธานี</h1>
      <p>
        บริษัทจดทะเบียนถูกต้อง มีหน้าร้านจริง ให้ราคายุติธรรม<br />
        บริการรับซื้อกล้องทั่วประเทศ ทาง LINE และ EMS
      </p>
    </div>

    <!-- Layout: map + info -->
    <div class="about-layout">
      <!-- Map -->
      <div>
        <div class="about-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3849.0251066841015!2d104.83948708529402!3d15.266426622549128!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x311687b7ef0583c9%3A0x90ad9a37b84af3a!2z4Lit4Liz4Lie4LilIOC5gOC4l-C4o-C4lOC4lOC4tOC5ieC4hyAtIOC4o-C4seC4muC4i-C4t-C5ieC4rSDguILguLLguKIg4LiL4LmI4Lit4LihIOC4hOC4reC4oeC4nuC4tOC4p-C5gOC4leC4reC4o-C5jCDguKHguLfguK3guJbguLfguK0g4LiB4Lil4LmJ4Lit4LiHIOC4peC4s-C5guC4nuC4hyDguKrguLTguJnguITguYnguLLguYTguK3guJfguLXguJfguLjguIHguIrguJnguLTguJQ!5e0!3m2!1sth!2sth!4v1781512837717!5m2!1sth!2sth"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="แผนที่ บริษัท อำพล เทรดดิ้ง จำกัด อุบลราชธานี"
          ></iframe>
        </div>
        <div style="margin-top:1rem;">
          <a
            class="btn btn--secondary btn--block"
            href="https://maps.app.goo.gl/LjeWLrvhDhcsgRYCA"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            ดูบน Google Maps
          </a>
        </div>
      </div>

      <!-- Company info -->
      <div class="about-info">
        <h2>ข้อมูลบริษัท</h2>
        <div class="about-info-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <div>
            <div class="about-info-item__label">ชื่อบริษัท</div>
            <div class="about-info-item__value">{COMPANY.name}</div>
          </div>
        </div>
        <div class="about-info-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <div class="about-info-item__label">ที่อยู่</div>
            <div class="about-info-item__value">{COMPANY.address}</div>
          </div>
        </div>
        <div class="about-info-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <div>
            <div class="about-info-item__label">โทรศัพท์</div>
            <div class="about-info-item__value">
              <a href={CONTACT.phoneHref}>064-257-9353</a>
            </div>
          </div>
        </div>
        <div class="about-info-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"></path>
          </svg>
          <div>
            <div class="about-info-item__label">LINE</div>
            <div class="about-info-item__value">
              <a href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">LINE: {LINE_ID}</a>
            </div>
          </div>
        </div>

        <!-- CTA under company info -->
        <div style="margin-top:2rem; display:flex; flex-direction:column; gap:.75rem;">
          <a class="btn btn--primary btn--block" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
            ส่งรูปประเมินราคา
          </a>
          <a class="btn btn--phone btn--block" href={CONTACT.phoneHref}>
            โทร 064-257-9353
          </a>
        </div>
      </div>
    </div>

    <!-- Trust gallery -->
    <section aria-labelledby="about-gallery-title" class="about-gallery-section">
      <h2 id="about-gallery-title">ร้านรับซื้อกล้องมือสอง อุบลราชธานี</h2>
      <p class="about-gallery-section__sub">มีหน้าร้านจริง โต๊ะตรวจเช็กกล้อง และทีมงานพร้อมประเมินราคา</p>
      <div class="about-gallery-grid">
        {ABOUT_TRUST_GALLERY.map((img) => (
          <figure class="about-gallery-item">
            <OptimizedImage image={img} class="about-gallery-item__img" />
            <figcaption>{img.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Trust block -->
    <section aria-labelledby="trust-title" style="margin-bottom:4rem;">
      <h2 id="trust-title" style="font-size:1.3rem;font-weight:800;text-align:center;margin-bottom:1.75rem;">ทำไมต้องเชื่อใจเรา</h2>
      <div class="about-trust-grid">
        <div class="about-trust-item">
          <span class="about-trust-item__icon" aria-hidden="true">✓</span>
          <h3>บริษัทจดทะเบียน</h3>
          <p>จดทะเบียนถูกต้องตามกฎหมาย มีเลขทะเบียนนิติบุคคล</p>
        </div>
        <div class="about-trust-item">
          <span class="about-trust-item__icon" aria-hidden="true">✓</span>
          <h3>มีหน้าร้านจริง</h3>
          <p>มาที่ร้านได้เลย อุบลราชธานี</p>
        </div>
        <div class="about-trust-item">
          <span class="about-trust-item__icon" aria-hidden="true">✓</span>
          <h3>ติดต่อได้หลายช่องทาง</h3>
          <p>LINE, โทรศัพท์, Facebook</p>
        </div>
        <div class="about-trust-item">
          <span class="about-trust-item__icon" aria-hidden="true">✓</span>
          <h3>ประเมินฟรี</h3>
          <p>ไม่มีค่าใช้จ่าย ไม่มีข้อผูกมัด</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
