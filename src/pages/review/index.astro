const galleryImages = [
  { src: '/images/uploads/2025/06/LINE_NOTE_250618_7.webp', alt: 'ตัวอย่างการโอนเงิน' },
  { src: '/images/uploads/2025/06/LINE_NOTE_250618_8.webp', alt: 'ตัวอย่างแชทประเมินราคา' },
  { src: '/images/uploads/2025/06/LINE_NOTE_250618_9.webp', alt: 'รับซื้อกล้องมือสอง' },
  { src: '/images/uploads/2025/06/LINE_NOTE_250618_10.webp', alt: 'ตัวอย่างงานรับซื้อ' },
  { src: '/images/uploads/2025/06/LINE_NOTE_250618_11.webp', alt: 'ลูกค้าพอใจ' },
  { src: '/images/uploads/2025/06/S__18694154.webp', alt: 'กล้องที่รับซื้อ' },
];
---

<BaseLayout page={page} bodyClass="page-review">
  <div class="inner-page">
    <!-- Hero -->
    <div class="review-hero">
      <p style="font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--primary);margin-bottom:.5rem;">รีวิวจากลูกค้า</p>
      <h1>รีวิวจากลูกค้าจริง</h1>
      <p>ลูกค้าที่ขายกล้องมือสองกับเราแล้วมากกว่า 1,000+ ราย</p>
    </div>

    <!-- Review grid -->
    <section aria-labelledby="reviews-h2" style="margin-bottom:3rem;">
      <h2 id="reviews-h2" class="sr-only">รีวิวทั้งหมด</h2>
      <div class="review-page-grid">
        {reviews.map((r) => (
          <div class="review-card">
            <div class="review-card__stars" aria-label={`${r.stars} ดาว`}>
              {Array.from({ length: r.stars }).map(() => <span aria-hidden="true">★</span>)}
            </div>
            <p class="review-card__text">"{r.text}"</p>
            <div class="review-card__author">
              <div class="review-card__avatar" aria-hidden="true">{r.name.charAt(2)}</div>
              <div>
                <div class="review-card__name">{r.name}</div>
                <div class="review-card__location">{r.location} · {r.camera}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA after reviews -->
    <div class="review-cta-banner">
      <h2>พอใจอยากขายกล้อง?</h2>
      <p>ส่งรูปมาประเมินราคาฟรี ตอบไว ได้ราคาดีเหมือนลูกค้าคนอื่น</p>
      <a class="btn btn--primary btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
        ส่งรูปประเมินราคาใน LINE
      </a>
    </div>

    <!-- Gallery from real transactions -->
    <section aria-labelledby="gallery-h2" style="margin:3rem 0 4rem;">
      <h2 id="gallery-h2" style="font-size:1.3rem;font-weight:800;margin-bottom:1.5rem;">ตัวอย่างการรับซื้อจริง</h2>
      <div class="gallery-grid">
        {galleryImages.map((img) => (
          <div class="gallery-item">
            <img
              src={img.src}
              alt={img.alt}
              width="400"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- Second CTA -->
    <div class="review-cta-banner" style="margin-bottom:4rem;">
      <h2>เริ่มขายกล้องได้เลยตอนนี้</h2>
      <p>ส่งรูปกล้อง รับราคาฟรีภายใน 30 นาที</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;">
        <a class="btn btn--primary btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
          แชท LINE ประเมินราคา
        </a>
        <a class="btn btn--secondary btn--lg" href={CONTACT.phoneHref}>โทร 064-257-9353</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
</style>
