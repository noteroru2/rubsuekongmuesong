---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageByPath } from '../../lib/content';
import { CONTACT } from '../../config/site';

const page = getPageByPath('/review/');
if (!page) throw new Error('Missing /review/ content');

