---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import QuickAnswerBox from '../../components/money/QuickAnswerBox.astro';
import FAQSection from '../../components/money/FAQSection.astro';
import LineCTA from '../../components/money/LineCTA.astro';
import RelatedProvinceLinks from '../../components/money/RelatedProvinceLinks.astro';
import { getPageByPath } from '../../lib/content';
import {
  getCameraModelPagesForBrandId,
  modelPageAnchor,
  modelPageHref,
  POPULAR_MODEL_BRANDS,
} from '../../lib/cameraModelPages';
import { BRAND_MONEY_PAGE_MAP } from '../../lib/moneyPages';
import { BRAND_IMAGES } from '../../lib/siteImages';
import { CONTACT } from '../../config/site';

const page = getPageByPath('/models/');
if (!page) throw new Error('Missing /models/ content');

const brands = [
  {
    ...BRAND_IMAGES.canon,
    badge: 'ยอดนิยม',
    models: [
      'EOS R5', 'EOS R6 Mark II', 'EOS R8', 'EOS R50', 'EOS R3',
      '5D Mark IV', '6D Mark II', '90D', '850D', '80D',
      'M50 Mark II', 'M6 Mark II', 'M200', 'G7X Mark III',
      'PowerShot G5X II', 'EOS RP',
    ],
  },
  {
    ...BRAND_IMAGES.sony,
    badge: 'ขายดี',
    models: [
      'A7 IV', 'A7 III', 'A7C', 'A7C II', 'A7R V', 'A7R IV',
      'A9 III', 'A9 II', 'A6700', 'A6600', 'A6400',
      'ZV-E10', 'ZV-1', 'RX100 VII', 'RX100 VI', 'RX10 IV',
    ],
  },
  {
    ...BRAND_IMAGES.fujifilm,
    badge: '',
    models: [
      'X-T5', 'X-T4', 'X-T3', 'X-S20', 'X-S10',
      'X-H2S', 'X-H2', 'X100VI', 'X100V', 'X-Pro3',
      'X-A7', 'X-A5', 'GFX 100S', 'GFX 50S II',
    ],
  },
  {
    ...BRAND_IMAGES.nikon,
    badge: '',
    models: [
      'Z8', 'Z9', 'Z6 III', 'Z6 II', 'Z7 II',
      'Z5 II', 'Z50', 'Zfc', 'D850', 'D750',
      'D7500', 'D5600', 'D3500', 'D810',
    ],
  },
  {
    ...BRAND_IMAGES.leica,
    badge: 'ราคาสูง',
    models: [
      'M11', 'M11-P', 'M10-R', 'M10', 'M6', 'MP',
      'Q3', 'Q2', 'Q', 'SL3', 'SL2', 'SL2-S',
      'CL', 'TL2', 'Monochrom',
    ],
  },
  {
    ...BRAND_IMAGES.panasonic,
    badge: '',
    models: [
      'S5 II', 'S5 IIX', 'S1R', 'S1', 'S1H',
      'GH6', 'GH5 II', 'GH5', 'G9 II', 'G9',
      'G7', 'GX9', 'LX100 II',
    ],
  },
  {
    ...BRAND_IMAGES.olympus,
    badge: '',
    models: [
      'OM-1 Mark II', 'OM-1', 'OM-5',
      'E-M1X', 'E-M1 Mark III', 'E-M5 Mark III',
      'E-M10 Mark IV', 'PEN-F', 'E-PL10', 'TG-7',
    ],
  },
  {
    ...BRAND_IMAGES.dji,
    badge: '',
    models: [
      'Mavic 3 Pro', 'Mavic 3 Classic', 'Mini 4 Pro', 'Mini 3 Pro',
      'Air 3', 'Avata 2', 'Osmo Action 5 Pro', 'Osmo Action 4',
      'Pocket 3', 'OM 6', 'RS 3 Pro',
    ],
  },
];
---

<BaseLayout page={page} bodyClass="page-models">
  <div class="inner-page">
    <!-- Hero -->
    <div class="models-hero">
      <p style="font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--primary);margin-bottom:.5rem;">รุ่นที่รับซื้อ</p>
      <h1>{page.seo.h1 || 'รุ่นกล้องมือสองที่เรารับซื้อ'}</h1>
      <p>Canon · Sony · Fujifilm · Nikon · Leica · Panasonic · Olympus · DJI และแบรนด์อื่นๆ<br />ประเมินฟรี ให้ราคายุติธรรม โอนทันที</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:1.5rem;">
        <a class="btn btn--primary btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
          ส่งรูปประเมินราคาฟรี
        </a>
        <a class="btn btn--secondary btn--lg" href={CONTACT.phoneHref}>โทร 064-257-9353</a>
      </div>
    </div>

  <!-- Popular model money pages -->
  <section class="money-section popular-model-pages" id="popular-models" aria-labelledby="popular-models-heading">
    <h2 id="popular-models-heading" class="money-section__title">รับซื้อกล้องตามรุ่นยอดนิยม</h2>
    <p>เลือกรุ่นที่ต้องการขาย ส่งรูปประเมินราคาผ่าน LINE ได้ทันที</p>
    {POPULAR_MODEL_BRANDS.map((group) => (
      <div class="popular-model-pages__brand" id={`popular-${group.id}`}>
        <h3 class="popular-model-pages__brand-name">{group.name}</h3>
        <ul class="popular-model-pages__list">
          {group.models.map((model) => (
            <li>
              <a href={modelPageHref(model.slug)}>{modelPageAnchor(model)}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

    <!-- Anchor tabs -->
    <nav class="brand-tabs" aria-label="แบรนด์กล้อง">
      <a class="brand-tab" href="#popular-models">รุ่นยอดนิยม</a>
      {brands.map((b) => (
        <a class="brand-tab" href={`#${b.id}`}>{b.name}</a>
      ))}
    </nav>

    <!-- Brand sections -->
    {brands.map((brand) => {
      const hub = BRAND_MONEY_PAGE_MAP.get(brand.id);
      const modelPageLinks = getCameraModelPagesForBrandId(brand.id);
      return (
      <section class="brand-section brand-section--hub" id={brand.id} aria-labelledby={`brand-${brand.id}`}>
        <div class="brand-section__header">
          <h2 class="brand-section__name" id={`brand-${brand.id}`}>รับซื้อกล้อง {brand.name} มือสอง</h2>
          {brand.badge && <span class="brand-section__badge">{brand.badge}</span>}
        </div>
        {hub && <QuickAnswerBox answer={hub.quickAnswer} />}
        <div class="brand-section__body">
          <div class="brand-section__img">
            <OptimizedImage src={brand.src} alt={brand.alt} width={brand.width} height={brand.height} />
          </div>
          <div class="brand-section__models">
            <h3>รุ่นที่รับซื้อ</h3>
            <ul>
              {(hub?.popularModels ?? brand.models).map((m) => <li>{m}</li>)}
            </ul>
            {modelPageLinks.length > 0 && (
              <>
                <h3>หน้ารับซื้อตามรุ่นยอดนิยม</h3>
                <ul class="brand-model-page-links">
                  {modelPageLinks.map((model) => (
                    <li>
                      <a href={modelPageHref(model.slug)}>{modelPageAnchor(model)}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {hub && (
              <>
                <h3>รุ่นยอดนิยมที่ขายง่าย</h3>
                <ul class="brand-easy-sell">
                  {hub.easySellModels.map((m) => <li>{m}</li>)}
                </ul>
                <h3>อุปกรณ์ที่ควรถ่ายรูปส่ง</h3>
                <ul class="brand-photo-checklist">
                  {hub.photoChecklist.map((item) => <li>{item}</li>)}
                </ul>
              </>
            )}
            <LineCTA title={`ส่งรูปประเมินราคา ${brand.name}`} compact />
          </div>
        </div>
        {hub && (
          <div class="brand-section__extras">
            <section class="money-section price-factors" aria-label={`ปัจจัยราคา ${brand.name}`}>
              <h3 class="money-section__title">ปัจจัยที่มีผลต่อราคา {brand.name}</h3>
              <ul class="price-factors__list">
                {hub.priceFactors.map((f) => (
                  <li class="price-factors__item">
                    <strong>{f.title}</strong>
                    <p>{f.description}</p>
                  </li>
                ))}
              </ul>
            </section>
            <FAQSection faqs={hub.faqs} heading={`คำถามเกี่ยวกับ ${brand.name}`} />
            <RelatedProvinceLinks provinces={hub.topProvinces} heading="รับซื้อกล้องตามจังหวัด" />
          </div>
        )}
      </section>
    )})}

    <!-- Final CTA -->
    <div class="review-cta-banner" style="margin-bottom:4rem;">
      <h2>ไม่เจอรุ่นที่ต้องการ?</h2>
      <p>เราซื้อกล้องทุกรุ่น ทุกแบรนด์ แม้ไม่มีในรายการ ส่งรูปมาถามได้เลย</p>
      <a class="btn btn--primary btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
        สอบถามราคาผ่าน LINE
      </a>
    </div>
  </div>
</BaseLayout>
