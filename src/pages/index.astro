---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import HomeInteractions from '../components/HomeInteractions.astro';
import { getBlogPosts } from '../lib/articles';
import { getHomePage } from '../lib/content';
import HomeProvinceLinks from '../components/money/HomeProvinceLinks.astro';
import { CONTACT, LINE_ID } from '../config/site';

const page = getHomePage();
if (!page) throw new Error('Homepage content missing. Run: npm run crawl');

const latestPosts = getBlogPosts().slice(0, 6);

const brands = [
  { id: 'canon',    name: 'Canon',            img: '/images/uploads/2025/06/รับซื้อกล้อง-canon.webp',        alt: 'รับซื้อกล้อง Canon มือสอง',    models: ['EOS R5', 'EOS R6 II', 'EOS R50', '5D Mark IV', '90D', 'M50 II'] },
  { id: 'sony',     name: 'Sony',             img: '/images/uploads/2025/06/Sony-A7-III-Body-Black-Thai-1.webp', alt: 'รับซื้อกล้อง Sony มือสอง',    models: ['A7 IV', 'A7 III', 'A7C', 'A6700', 'RX100 VII', 'ZV-E10'] },
  { id: 'fujifilm', name: 'Fujifilm',         img: '/images/uploads/2025/06/DSCF0088-Photoroom-1-1.webp',       alt: 'รับซื้อกล้อง Fujifilm มือสอง', models: ['X-T5', 'X-T4', 'X-S20', 'X100VI', 'GFX 100S', 'X-A7'] },
  { id: 'nikon',    name: 'Nikon',            img: '/images/uploads/2025/06/70d.webp',                          alt: 'รับซื้อกล้อง Nikon มือสอง',   models: ['Z8', 'Z6 III', 'Z5 II', 'D850', 'D750', 'Z50'] },
  { id: 'leica',    name: 'Leica',            img: '/images/uploads/2025/06/รับซื้อกล้องมือสอง.webp',          alt: 'รับซื้อกล้อง Leica มือสอง',   models: ['M11', 'M10', 'Q3', 'Q2', 'SL2', 'M6'] },
  { id: 'panasonic',name: 'Panasonic',        img: '/images/uploads/2025/06/กล้อง-Mirrorless.webp',            alt: 'รับซื้อกล้อง Panasonic มือสอง',models: ['S5 II', 'S1', 'GH6', 'GH5', 'G9 II', 'G7'] },
  { id: 'olympus',  name: 'Olympus',          img: '/images/uploads/2025/06/กล้องคอมแพค.webp',                 alt: 'รับซื้อกล้อง Olympus มือสอง', models: ['OM-5', 'E-M1 III', 'E-M10 IV', 'E-M5 III', 'PEN-F', 'E-PL10'] },
  { id: 'dji',      name: 'DJI',              img: '/images/uploads/2025/06/Osmo-Action-5-Pro.webp',             alt: 'รับซื้อกล้อง DJI มือสอง',     models: ['Osmo Action 5 Pro', 'Mavic 3 Pro', 'Mini 4 Pro', 'Pocket 3', 'OM 6', 'Air 3'] },
];

const galleryItems = [
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_1.webp',   alt: 'รับซื้อกล้อง Fujifilm',       wide: true },
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_2.webp',   alt: 'ตรวจเช็กสภาพกล้อง',           wide: false },
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_3.webp',   alt: 'รับซื้อเลนส์มือสอง',          wide: false },
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_4.webp',   alt: 'รับซื้อ Sony A7 III',          wide: false },
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_5.webp',   alt: 'รับซื้อถึงที่',               wide: true },
  { img: '/images/uploads/2025/06/LINE_NOTE_250618_6.webp',   alt: 'ตรวจสอบอุปกรณ์ครบชุด',        wide: false },
];

const reviews = [
  { name: 'คุณกัญญารัตน์', location: 'อุบลราชธานี', camera: 'Leica M6',
    text: 'ขาย Leica M6 ได้ราคาดีมาก ประเมินไว โอนเงินทันทีหลังตกลงราคา ไม่มีการกดราคาเลย' },
  { name: 'คุณเอกชัย', location: 'ขอนแก่น', camera: 'Sony A7 III',
    text: 'ส่งรูปปุ๊บ รู้ราคาใน 10 นาที โอนเงินจริงใน 5 นาทีหลังส่งกล้อง ไม่เคยคิดว่าขายกล้องออนไลน์จะง่ายแบบนี้' },
  { name: 'คุณศิริพร', location: 'กรุงเทพฯ', camera: 'Fujifilm X-T4',
    text: 'ส่ง EMS พร้อมเลนส์ 2 ตัว ได้ราคาตรงตามที่คุยไว้ทาง LINE ไม่มีการแอบลดหลังดูของ' },
  { name: 'คุณชัยณรงค์', location: 'เชียงใหม่', camera: 'Canon 90D',
    text: 'ได้ราคาสูงกว่าที่คิดไว้ตั้งแต่แรก แนะนำคนรู้จักไปขายด้วยแล้วหลายคน ทุกคนพอใจ' },
];
---

<BaseLayout page={page} bodyClass="page-home">

  <!-- ─── HERO ─── -->
  <section class="hero" aria-label="รับซื้อกล้องมือสอง">
    <div class="hero__inner">
      <div class="hero__content">
        <p class="hero__location">อุบลราชธานี · มีหน้าร้านจริง · รับทั่วประเทศ</p>
        <h1>
          รับซื้อกล้องมือสอง<br />
          <span class="accent">ให้ราคาดี โอนทันที</span>
        </h1>
        <p class="hero__sub">
          Canon · Sony · Nikon · Fujifilm · Leica · DJI<br />
          ส่งรูปประเมินฟรี ตอบไว 10–30 นาที
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"></path>
            </svg>
            ส่งรูปประเมินราคา
          </a>
          <a class="btn btn--secondary btn--lg" href="/models/">ดูรุ่นที่รับซื้อ</a>
        </div>
        <nav class="hero__links" aria-label="ลิงก์ที่เกี่ยวข้อง">
          <a href="/models/">รุ่นที่รับซื้อทุกแบรนด์</a>
          <span aria-hidden="true">·</span>
          <a href="/article/shutter-count/">เช็ค Shutter Count ก่อนขาย</a>
          <span aria-hidden="true">·</span>
          <a href="/category/รับซื้อกล้อง/">รับซื้อตามจังหวัด</a>
        </nav>
        <div class="hero__stats">
          <div class="hero__stat">
            <strong>1,000+</strong>
            <span>กล้องที่รับซื้อแล้ว</span>
          </div>
          <div class="hero__stat-divider" aria-hidden="true"></div>
          <div class="hero__stat">
            <strong>10–30 นาที</strong>
            <span>รับราคาทาง LINE</span>
          </div>
          <div class="hero__stat-divider" aria-hidden="true"></div>
          <div class="hero__stat">
            <strong>ทั่วประเทศ</strong>
            <span>รับถึงบ้าน / EMS</span>
          </div>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__img-wrap">
          <img
            src="/images/uploads/2025/06/รับซื้อกล้องมือสอง.webp"
            alt="รับซื้อกล้องมือสองทุกยี่ห้อ อุบลราชธานี"
            width="420"
            height="315"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TOP PROVINCES ─── -->
  <HomeProvinceLinks />

  <!-- ─── QUICK CONTACT ─── -->
  <section class="quick-contact" aria-label="ติดต่อประเมินราคา">
    <div class="quick-contact__inner">
      <div class="quick-contact__header">
        <div class="quick-contact__qr-wrap">
          <img
            src="/images/uploads/2025/06/M_gainfriends_2dbarcodes_BW.webp"
            alt="QR Code LINE @webuy"
            width="80"
            height="80"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="quick-contact__copy">
          <h2>ประเมินราคากล้องฟรี</h2>
          <p>ส่งรูปกล้อง/เลนส์ รับราคาภายใน 10–30 นาที ไม่มีค่าใช้จ่าย ไม่มีข้อผูกมัด</p>
        </div>
      </div>

      <div class="quick-contact__btns">
        <a class="btn btn--line btn--lg" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"></path>
          </svg>
          แชท LINE {LINE_ID}
        </a>
        <a class="btn btn--phone btn--lg" href={CONTACT.phoneHref}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          โทร 064-257-9353
        </a>
      </div>

      <hr class="quick-contact__divider" />
      <p class="quick-contact__form-title">หรือกรอกข้อมูลให้เราโทรกลับ</p>
      <form class="estimate-form" id="estimate-form" aria-label="ฟอร์มขอประเมินราคา">
        <div class="estimate-form__field">
          <label for="camera-model">รุ่นกล้อง / เลนส์</label>
          <input type="text" id="camera-model" name="camera" placeholder="เช่น Sony A7 IV, Fujifilm X-T5" autocomplete="off" />
        </div>
        <div class="estimate-form__field">
          <label for="accessories">อุปกรณ์ที่มี</label>
          <input type="text" id="accessories" name="accessories" placeholder="เช่น กล่อง, ชาร์จ, เลนส์ kit" autocomplete="off" />
        </div>
        <div class="estimate-form__field estimate-form__submit">
          <label for="contact-line">เบอร์โทร / LINE ID</label>
          <input type="text" id="contact-line" name="contact" placeholder="เช่น 081-234-5678 หรือ LINE ID" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn--primary btn--block estimate-form__submit">
          ส่งข้อมูลขอประเมินราคา →
        </button>
      </form>
    </div>
  </section>

  <!-- ─── BRANDS ─── -->
  <section class="brands-section" aria-labelledby="brands-title">
    <div class="brands-section__inner">
      <div class="brands-section__head">
        <h2 id="brands-title">รับซื้อกล้องทุกแบรนด์</h2>
        <a href="/models/" class="brands-section__all">ดูรายการทั้งหมด →</a>
      </div>
      <div class="brands-grid">
        {brands.map((brand) => (
          <div class="brand-card">
            <div class="brand-card__img">
              <img src={brand.img} alt={brand.alt} width="320" height="180" loading="lazy" decoding="async" />
            </div>
            <div class="brand-card__body">
              <h3 class="brand-card__name">{brand.name}</h3>
              <ul class="brand-card__models">
                {brand.models.map((m) => <li>{m}</li>)}
              </ul>
              <a class="btn btn--outline-red brand-card__cta" href={`/models/#${brand.id}`}>
                ดูรุ่นที่รับซื้อ →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── HOW IT WORKS (STEPS) ─── -->
  <section class="process-section" aria-labelledby="process-title">
    <div class="process-section__inner">
      <h2 id="process-title">ขายกล้องยังไง?</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="process-step__n" aria-hidden="true">01</span>
          <div class="process-step__body">
            <h3>ถ่ายรูปกล้องแล้วส่งมาทาง LINE</h3>
            <p>รูปด้านหน้า ด้านหลัง จอ และอุปกรณ์ที่มี ไม่ต้องนัดล่วงหน้า ส่งได้ทุกเวลา</p>
          </div>
        </div>
        <div class="process-step__arrow" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
        <div class="process-step">
          <span class="process-step__n" aria-hidden="true">02</span>
          <div class="process-step__body">
            <h3>รับราคาประเมินภายใน 30 นาที</h3>
            <p>เจ้าหน้าที่ดูรูปแล้วแจ้งราคา ถ้าพอใจก็นัดส่งได้เลย ไม่พอใจก็ไม่ต้องขาย</p>
          </div>
        </div>
        <div class="process-step__arrow" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </div>
        <div class="process-step">
          <span class="process-step__n" aria-hidden="true">03</span>
          <div class="process-step__body">
            <h3>ส่ง EMS หรือนัดรับ แล้วรับเงิน</h3>
            <p>ตรวจสภาพเสร็จโอนทันที ส่วนใหญ่ได้เงินภายในวันเดียวกัน</p>
          </div>
        </div>
      </div>
      <a class="process-section__cta" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
        เริ่มขายกล้องเลย — แชท LINE {LINE_ID}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ─── GALLERY ─── -->
  <section class="mosaic-section" aria-label="ตัวอย่างงานรับซื้อจริง">
    <div class="mosaic-section__inner">
      <div class="mosaic-grid">
        {galleryItems.map((item, i) => (
          <div class:list={['mosaic-item', item.wide && 'mosaic-item--wide']}>
            <img
              src={item.img}
              alt={item.alt}
              width="400"
              height="300"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))}
      </div>
      <p class="mosaic-section__caption">ตัวอย่างงานรับซื้อจริง — ส่งผ่าน EMS ทั่วประเทศ</p>
    </div>
  </section>

  <!-- ─── REVIEWS ─── -->
  <section class="quotes-section" aria-labelledby="quotes-title">
    <div class="quotes-section__inner">
      <div class="quotes-header">
        <h2 id="quotes-title">ลูกค้าพูดถึงเรา</h2>
        <a href="/review/" class="quotes-header__more">ดูรีวิวทั้งหมด →</a>
      </div>
      <div class="quotes-grid">
        {reviews.map((r) => (
          <blockquote class="quote-block">
            <svg class="quote-block__mark" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true" width="32" height="24">
              <path d="M0 24V14.4C0 6.4 4.8 1.6 14.4 0l1.6 2.4C10.4 3.6 7.2 6.4 6.4 11.2H12V24H0zm20 0V14.4C20 6.4 24.8 1.6 34.4 0L36 2.4C30.4 3.6 27.2 6.4 26.4 11.2H32V24H20z"/>
            </svg>
            <p class="quote-block__text">{r.text}</p>
            <footer class="quote-block__author">
              <span class="quote-block__name">{r.name}</span>
              <span class="quote-block__meta">{r.location} · {r.camera}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── WHY US (feature list, no emoji) ─── -->
  <section class="features-section" aria-labelledby="features-title">
    <div class="features-section__inner">
      <div class="features-left">
        <h2 id="features-title">ทำไมต้องขายกล้องกับเรา</h2>
        <p class="features-left__sub">เราซื้อกล้องมือสองมามากกว่า 10 ปี รู้ราคาตลาดดี ไม่กดราคา ไม่มีกั๊กข้อมูล</p>
        <a class="btn btn--primary" href={CONTACT.lineCta} target="_blank" rel="noopener noreferrer">
          ส่งรูปประเมินราคาฟรี
        </a>
      </div>
      <div class="features-right">
        <div class="feature-row">
          <span class="feature-row__n">01</span>
          <div>
            <h3>ให้ราคาตามตลาดจริง</h3>
            <p>ประเมินจากราคาซื้อขายจริงในตลาด ไม่ใช่ราคาที่คิดเอง บอกราคาตรงๆ ไม่บวก-ลบหลังดูของ</p>
          </div>
        </div>
        <div class="feature-row">
          <span class="feature-row__n">02</span>
          <div>
            <h3>มีหน้าร้านจริงให้ตรวจสอบได้</h3>
            <p>บริษัทจดทะเบียนถูกต้อง มีที่อยู่ชัดเจน ถ้าอยู่ใกล้อุบลฯ มาที่ร้านก็ได้ ไม่ใช่แค่เพจออนไลน์</p>
          </div>
        </div>
